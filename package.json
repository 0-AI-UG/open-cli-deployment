{
  "name": "open-cli-deployment",
  "version": "0.8.2",
  "description": "A self-hosted, CLI-first platform for deploying containers to your own servers.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/0-AI-UG/open-cli-deployment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0-AI-UG/open-cli-deployment.git"
  },
  "bugs": {
    "url": "https://github.com/0-AI-UG/open-cli-deployment/issues"
  },
  "engines": {
    "bun": ">=1.3.5 <2"
  },
  "packageManager": "bun@1.3.5",
  "type": "module",
  "scripts": {
    "start": "OCD_MODE=server bun run src/server/index.ts",
    "engine": "OCD_MODE=engine bun run src/engine/entrypoint.ts",
    "engine:dev": "OCD_MODE=engine bun run src/engine/entrypoint.ts",
    "dev": "bun run build:css && OCD_MODE=server SKIP_2FA=1 bun --watch run src/server/index.ts",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/web/src/tailwind.css -o src/web/src/tailwind.generated.css --minify",
    "build": "bun run build:css && bun build src/web/index.html --outdir=src/web/dist",
    "typecheck": "tsc --noEmit",
    "test": "bun run scripts/test.ts",
    "test:integration": "RUN_INTEGRATION=1 bun test src/integration/",
    "test:integration:engine": "RUN_INTEGRATION=1 bun test src/integration/engine-ops.test.ts",
    "test:component:build": "RUN_BUILD_COMPONENT=1 bun test src/integration/build-registry.test.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "restore:panel": "bun run scripts/restore-panel.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  }
}
